lexer grammar Json5Lexer;

// ============================================================
// 隐藏通道：空白与注释
// ============================================================
WS
    : [ \t\r\n\uFEFF]+ -> channel(HIDDEN)
    ;

LINE_COMMENT
    : '//' ~[\r\n]* -> channel(HIDDEN)
    ;

BLOCK_COMMENT
    : '/*' .*? '*/' -> channel(HIDDEN)
    ;

// ============================================================
// 字符串
// ============================================================
TRIPLE_DOUBLE_STRING
    : '"""' .*? '"""'
    ;

TRIPLE_SINGLE_STRING
    : '\'\'\'' .*? '\'\'\''
    ;

STRING
    : '"' ( ESC | LINE_CONT | ~["\\\r\n] )* '"'
    | '\'' ( ESC | LINE_CONT | ~['\\\r\n] )* '\''
    ;

fragment ESC
    : '\\' ["\\/bfnrt]
    | '\\' 'u' HEX HEX HEX HEX
    ;

fragment LINE_CONT
    : '\\' [\r\n\u2028\u2029]
    | '\\' '\r' '\n'
    ;

fragment HEX
    : [0-9a-fA-F]
    ;

// ============================================================
// 数字
// ============================================================
NUMBER
    : [+-]? INT ('.' [0-9]+)? EXP?
    | [+-]? '.' [0-9]+ EXP?
    | '0' [xX] HEX+
    ;

fragment INT
    : '0'
    | [1-9] [0-9]*
    ;

fragment EXP
    : [eE] [+-]? [0-9]+
    ;

// ============================================================
// 字面量
// ============================================================
TRUE     : 'true';
FALSE    : 'false';
NULL     : 'null';
INFINITY : 'Infinity';
NAN      : 'NaN';

// ============================================================
// 标识符 - 完整 Unicode 支持（lexer 只做 tokenization）
// ============================================================
IdentifierName
    : IdentifierStart IdentifierPart*
    ;

// 完整的 Unicode 标识符支持（JSON5 规范）
fragment IdentifierStart
    : [A-Za-z_$]
    | [\u00A0-\uFFFF]              // 完整的 Unicode BMP
    | '\\' 'u' HEX HEX HEX HEX
    ;

fragment IdentifierPart
    : IdentifierStart
    | [0-9]
    | [\u0300-\u036F]              // 组合音标符号
    | [\u200C-\u200D]              // 零宽连接符
    | '\\' 'u' HEX HEX HEX HEX
    ;

// ============================================================
// 标点符号
// ============================================================
LBRACE   : '{';
RBRACE   : '}';
LBRACK   : '[';
RBRACK   : ']';
COLON    : ':';
COMMA    : ',';
PLUS     : '+';
MINUS    : '-';

// ============================================================
// 错误处理 - 保持可见，让 parser 处理
// ============================================================
UNKNOWN  : .;